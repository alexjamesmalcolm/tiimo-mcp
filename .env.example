# Set through Railway Variables. Never commit actual values or paste tokens into chat.
TIIMO_TOKEN=
TIIMO_PROFILE_ID=
# Alternatively, local deployments can read a token file on every API call.
# TIIMO_TOKEN_FILE=/absolute/path/tiimo.token
TIIMO_READ_ONLY=false

# HTTPS origin, without /mcp. Railway's generated RAILWAY_PUBLIC_DOMAIN is also supported.
PUBLIC_URL=https://your-service.up.railway.app
OAUTH_CLIENT_ID=tiimo-private
# Generate each secret independently: openssl rand -hex 32
OAUTH_CLIENT_SECRET=
MCP_LOGIN_PASSWORD=
# Exact redirects only. Default is the stable ChatGPT redirect shown below.
OAUTH_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect
# PORT is supplied by Railway; local HTTP defaults to 8080.

# Attach a Railway volume at /data. Startup sets ownership and then drops privileges.
AUTH_DB_PATH=/data/auth/auth.db
RAILWAY_RUN_UID=0
