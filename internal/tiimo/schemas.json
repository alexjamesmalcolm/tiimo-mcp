  "WebApi.Calendar.Models.RepetitionForCreationDto": {
    "type": "object",
    "properties": {
      "type": {
        "$ref": "#/components/schemas/WebApi.Data.Calendar.Entities.RepetitionEntityType"
      },
      "interval": {
        "type": "integer",
        "description": "Weeks/days/months/years between occurrences. For weekly repeats this replaces the obsolete\nWebApi.Calendar.Models.RepetitionForCreationDto.WeeklyFrequency: when a caller sends only that field, its value is used here.",
        "format": "int32"
      },
      "byMonth": {
        "type": [
          "null",
          "array"
        ],
        "items": {
          "type": "integer",
          "format": "int32"
        }
      },
      "weeklyFrequency": {
        "type": [
          "null",
          "integer"
        ],
        "format": "int32",
        "deprecated": true
      },
      "weeklyDays": {
        "type": [
          "null",
          "array"
        ],
        "items": {
          "$ref": "#/components/schemas/WebApi.Data.Common.Models.Weekdays"
        }
      },
      "monthlyDays": {
        "type": [
          "null",
          "array"
        ],
        "items": {
          "type": "integer",
          "format": "int32"
        }
      },
      "amountOfRepetitions": {
        "type": [
          "null",
          "integer"
        ],
        "description": "Setting this field to anything other than 0 calculates the EndDate from the repetition settings chosen",
        "format": "int32"
      },
      "firstDay": {
        "type": [
          "null",
          "string"
        ],
        "description": "By default the start time of the repeated activity is used. Setting FirstDay overwrites the start time.",
        "format": "date-time",
        "example": "2026-10-06T02:35:40"
      },
      "lastDay": {
        "type": [
          "null",
          "string"
        ],
        "description": "LastDay is not required, and should only be sent if the user sets a specific end date for the repetition. Should not be used together with AmountOfRepetitions.",
        "format": "date-time",
        "example": "2026-10-06T02:35:40"
      },
      "daily": {
        "type": "boolean"
      },
      "weekly": {
        "type": "boolean"
      },
      "monthly": {
        "type": "boolean"
      },
      "yearly": {
        "type": "boolean"
      }
    },
    "additionalProperties": false,
    "description": "NOTE: The settings chosen for custom Weekly and Monthly repetitions will only be used if the RecurrenceType sent is true.\nFirstDay, LastDay and AmountOfRepetitions will always be used\n\nFor the boolean fields Weekly and Monthly:\n- Please send exactly one of these as true\n            \nIf the chosen repetition type is weekly:\n- WeeklyFrequency and WeeklyDays should be sent.\n- Default values if left empty are WeeklyFrequency = 1 (every week) and WeeklyDays = All days\n            \nIf the chosen repetition type is monthly\n- MonthlyDays should be sent\n- Default value for days is the current day of this month only"
  },
